# Shared local environment for seta-dam
# Copy to .env at repo root. Consumed by:
#   - docker compose  (via the infra/.env symlink -> ../.env)
#   - access-core      (dotenv, loads repo-root .env)
#   - asset-core       (godotenv, loads repo-root .env)
#
# PORT is intentionally omitted: asset-core defaults to 8080 and
# access-core to 4000, so a single shared PORT would collide.

# --- asset_db / asset-core ---
ASSET_DB_HOST=localhost
ASSET_DB_PORT=5433
ASSET_DB_NAME=asset_db
ASSET_DB_USER=asset_user
ASSET_DB_PASSWORD=asset_password
ASSET_DB_SSLMODE=disable

# --- access_db / access-core ---
ACCESS_DB_HOST=localhost
ACCESS_DB_PORT=5434
ACCESS_DB_NAME=access_db
ACCESS_DB_USER=access_user
ACCESS_DB_PASSWORD=access_password

# --- access-core service ---
HOST=0.0.0.0
GO_ASSET_URL=http://localhost:8080
# Shared secret for Access Core -> Asset Core internal requests. Use a unique,
# non-placeholder value in every environment and do not commit the real secret.
ASSET_INTERNAL_API_TOKEN=replace-with-a-long-random-secret

# --- access-core circuit breaker ---
ACCESS_ASSET_BREAKER_ENABLED=true
ACCESS_ASSET_BREAKER_ERROR_THRESHOLD_PCT=50
ACCESS_ASSET_BREAKER_VOLUME_THRESHOLD=10
ACCESS_ASSET_BREAKER_RESET_MS=5000
ACCESS_ASSET_BREAKER_CAPACITY=50

# --- host-published port for the access-core container (compose only) ---
NODE_ACCESS_CORE_PORT=4000

# --- Kafka (KAN-81 event transport) ---
# Local development only: single-node KRaft, replication factor 1, PLAINTEXT.
# Production requires >=3 brokers, replication factor 3, min.insync.replicas 2,
# and SECURITY_PROTOCOL=SASL_SSL with real credentials.
# Host processes use the HOST listener; inside compose, services use kafka:9092.
# Like GO_ASSET_URL, this value is deliberately not interpolated into compose.
ASSET_KAFKA_BROKERS=localhost:29092
ASSET_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
ASSET_KAFKA_SASL_MECHANISM=
ASSET_KAFKA_SASL_USERNAME=
ASSET_KAFKA_SASL_PASSWORD=
ASSET_KAFKA_MEDIA_TOPIC=media-processing.v1
ASSET_KAFKA_MEDIA_PARTITIONS=3
ASSET_KAFKA_MEDIA_DLQ_TOPIC=media-processing-dlq.v1
ASSET_KAFKA_MEDIA_GROUP_ID=media-workers-v1
ASSET_KAFKA_WRITE_TIMEOUT_MS=10000
ASSET_KAFKA_MAX_ATTEMPTS=3

# --- outbox relay (KAN-81) ---
ASSET_OUTBOX_RELAY_BATCH_SIZE=50
ASSET_OUTBOX_RELAY_LEASE_MS=30000
ASSET_OUTBOX_RELAY_LEASE_MARGIN_MS=5000
ASSET_OUTBOX_RELAY_BASE_BACKOFF_MS=250
ASSET_OUTBOX_RELAY_MAX_BACKOFF_MS=30000

# --- host-published Kafka port (compose only) ---
KAFKA_HOST_PORT=29092

# --- object storage (KAN-85 media originals) ---
# Local development only: one private bucket over HTTP with development
# credentials. Staging and production require a supported MinIO distribution,
# HTTPS on both endpoints, and credentials issued outside this file.
# The internal endpoint is what containers call; the public endpoint is what
# presigned URLs are signed against and is never rewritten after signing, so a
# host process and a container legitimately disagree about the first one.
ASSET_MEDIA_BUCKET=seta-media
ASSET_MEDIA_S3_REGION=us-east-1
ASSET_MEDIA_S3_INTERNAL_ENDPOINT=http://localhost:9000
ASSET_MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000
ASSET_MEDIA_S3_ACCESS_KEY_ID=seta-media-local
ASSET_MEDIA_S3_SECRET_ACCESS_KEY=seta-media-local-secret
ASSET_MEDIA_S3_USE_PATH_STYLE=true
ASSET_MEDIA_S3_CHECKSUM_SUPPORTED=true

# --- host-published MinIO ports (compose only) ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- media limits (KAN-85) ---
ASSET_MEDIA_MAX_UPLOAD_BYTES=50000000
ASSET_MEDIA_MAX_IMAGE_SIDE_PX=20000
ASSET_MEDIA_MAX_IMAGE_PIXELS=50000000
ASSET_MEDIA_DEFAULT_RAW_QUOTA_BYTES=10737418240
ASSET_MEDIA_CREDENTIAL_TTL_MINUTES=60
ASSET_MEDIA_SESSION_TTL_HOURS=24
ASSET_MEDIA_OUTPUT_LINK_TTL_MINUTES=15
ASSET_MEDIA_CLEANUP_QUARANTINE_HOURS=24

# --- media processing retry and leases (KAN-85 schema, KAN-86 worker) ---
# These delays reschedule work. They are a different axis from the outbox
# relay backoff above, which reschedules a publication; do not reconcile them.
ASSET_MEDIA_MAX_PROCESSING_ATTEMPTS=3
ASSET_MEDIA_RETRY_DELAY_1_SECONDS=2
ASSET_MEDIA_RETRY_DELAY_2_SECONDS=10
# Lease expiry must stay comfortably above the renewal interval so ordinary
# scheduling jitter never revokes work a live worker still holds.
ASSET_MEDIA_LEASE_RENEWAL_SECONDS=10
ASSET_MEDIA_LEASE_EXPIRY_SECONDS=40
ASSET_MEDIA_RECONCILE_INTERVAL_SECONDS=30
ASSET_MEDIA_RECONCILE_BATCH_SIZE=50
ASSET_MEDIA_RECONCILE_STALE_SECONDS=60
ASSET_MEDIA_PROCESSOR_DEADLINE_SECONDS=90

# --- media transport security and rollout flags ---
# HTTPS enforcement is on by default and must only be disabled for local work.
NODE_ENV=development
ASSET_MEDIA_REQUIRE_HTTPS=false
ACCESS_MEDIA_REQUIRE_HTTPS=false
ACCESS_MEDIA_UPLOAD_ENABLED=false
ACCESS_TRUSTED_PROXIES=127.0.0.1,::1
ACCESS_MEDIA_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:4000
ASSET_MEDIA_CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:4000
# Configure a generated secret in deployed environments. Operators present it
# separately through ASSET_MEDIA_REPLAY_AUTHORIZATION for one replay invocation.
ASSET_MEDIA_REPLAY_TOKEN=replace-with-a-long-random-replay-secret

# --- media rate limits (Access Core, Redis counters) ---
ACCESS_MEDIA_SESSION_LIMIT_PER_USER_PER_MINUTE=10
ACCESS_MEDIA_SESSION_LIMIT_PER_ORG_PER_MINUTE=60

# Media-to-Asset dependency isolation. These values are intentionally separate
# from ACCESS_ASSET_BREAKER_* authorization traffic settings.
ACCESS_MEDIA_BREAKER_ENABLED=true
ACCESS_MEDIA_FETCH_TIMEOUT_MS=60000
ACCESS_MEDIA_BREAKER_ERROR_THRESHOLD_PCT=50
ACCESS_MEDIA_BREAKER_VOLUME_THRESHOLD=10
ACCESS_MEDIA_BREAKER_RESET_MS=65000
ACCESS_MEDIA_BREAKER_CAPACITY=50
