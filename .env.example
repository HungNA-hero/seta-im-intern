# Shared local environment for seta-dam
# Copy to .env at repo root. Consumed by:
#   - docker compose  (via the infra/.env symlink -> ../.env)
#   - access-core      (dotenv, loads repo-root .env)
#   - asset-core       (godotenv, loads repo-root .env)
#
# PORT is intentionally omitted: asset-core defaults to 8080 and
# access-core to 4000, so a single shared PORT would collide.

# --- asset_db / asset-core ---
ASSET_DB_HOST=localhost
ASSET_DB_PORT=5433
ASSET_DB_NAME=asset_db
ASSET_DB_USER=asset_user
ASSET_DB_PASSWORD=asset_password
ASSET_DB_SSLMODE=disable

# --- access_db / access-core ---
ACCESS_DB_HOST=localhost
ACCESS_DB_PORT=5434
ACCESS_DB_NAME=access_db
ACCESS_DB_USER=access_user
ACCESS_DB_PASSWORD=access_password

# --- access-core service ---
HOST=0.0.0.0
GO_ASSET_URL=http://localhost:8080
# Shared secret for Access Core -> Asset Core internal requests. Use a unique,
# non-placeholder value in every environment and do not commit the real secret.
ASSET_INTERNAL_API_TOKEN=replace-with-a-long-random-secret

# --- access-core circuit breaker ---
ACCESS_ASSET_BREAKER_ENABLED=true
ACCESS_ASSET_BREAKER_ERROR_THRESHOLD_PCT=50
ACCESS_ASSET_BREAKER_VOLUME_THRESHOLD=10
ACCESS_ASSET_BREAKER_RESET_MS=5000
ACCESS_ASSET_BREAKER_CAPACITY=50

# --- host-published port for the access-core container (compose only) ---
NODE_ACCESS_CORE_PORT=4000

# --- Kafka (KAN-81 event transport) ---
# Local development only: single-node KRaft, replication factor 1, PLAINTEXT.
# Production requires >=3 brokers, replication factor 3, min.insync.replicas 2,
# and SECURITY_PROTOCOL=SASL_SSL with real credentials.
# Host processes use the HOST listener; inside compose, services use kafka:9092.
# Like GO_ASSET_URL, this value is deliberately not interpolated into compose.
ASSET_KAFKA_BROKERS=localhost:29092
ASSET_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
ASSET_KAFKA_SASL_MECHANISM=
ASSET_KAFKA_SASL_USERNAME=
ASSET_KAFKA_SASL_PASSWORD=
ASSET_KAFKA_MEDIA_TOPIC=media-processing.v1
ASSET_KAFKA_MEDIA_DLQ_TOPIC=media-processing-dlq.v1
ASSET_KAFKA_MEDIA_GROUP_ID=media-workers-v1
ASSET_KAFKA_WRITE_TIMEOUT_MS=10000
ASSET_KAFKA_MAX_ATTEMPTS=3

# --- outbox relay (KAN-81) ---
ASSET_OUTBOX_RELAY_BATCH_SIZE=50
ASSET_OUTBOX_RELAY_LEASE_MS=30000
ASSET_OUTBOX_RELAY_LEASE_MARGIN_MS=5000
ASSET_OUTBOX_RELAY_BASE_BACKOFF_MS=250
ASSET_OUTBOX_RELAY_MAX_BACKOFF_MS=30000

# --- host-published Kafka port (compose only) ---
KAFKA_HOST_PORT=29092
