{
  "name": "node-access-core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\" \"package.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\" \"package.json\" \"tsconfig.json\"",
    "lint": "npm run typecheck && npm run format:check",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^4",
    "graphql": "^16",
    "graphql-yoga": "^5",
    "ioredis": "^5.11.1",
    "opossum": "^10.0.0",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8",
    "prettier": "^3.9.6",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "esbuild@0.28.1": true
  }
}
